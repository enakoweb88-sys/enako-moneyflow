# Copy these non-secret names into /opt/moneyflow/.env and set real values there.
# Never commit /opt/moneyflow/.env or real credentials.

# Supabase Session Pooler connection (SSL required)
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your-project-reference
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# MTN MoMo Cameroon Collections. Store real values only in /opt/moneyflow/.env.
PRIMARY_KEY=
SECONDARY_KEY=
DEPOSIT_API_KEY=
DEPOSIT_API_USER=
MTN_MOMO_BASE_URL=https://momoapi.momo.africa
MTN_MOMO_TARGET_ENVIRONMENT=mtncameroon
MTN_MOMO_CALLBACK_URL=https://api.moneyflow.enako.cm/api/v1/provider-callbacks/mtn

# Reserved for future Live disbursements; Pilot Live never uses these.
DISBURSEMENT_PRIMARY_KEY=
DISBURSEMENT_SECONDARY_KEY=
PAYMENTS_API_KEY=
PAYMENTS_API_USER=

# PixiPay Orange Cameroon cash-in. Endpoint details must match the partner portal contract.
PIX_PAY_API_KEY=
PIX_PAY_ORANGE_CM_CASHIN_SERVICE_ID=
PIX_PAY_ORANGE_CM_CASHOUT_SERVICE_ID=
PIX_PAY_BASE_URL=
PIX_PAY_CALLBACK_URL=https://api.moneyflow.enako.cm/api/v1/provider-callbacks/pixipay

# Immutable GHCR image references, set after CI publishes the first build.
BACKEND_IMAGE=ghcr.io/enakoweb88-sys/enako-moneyflow-backend:replace-with-commit-sha
ADMIN_IMAGE=ghcr.io/enakoweb88-sys/enako-moneyflow-admin-web:replace-with-commit-sha
CUSTOMER_IMAGE=ghcr.io/enakoweb88-sys/enako-moneyflow-customer-web:replace-with-commit-sha
