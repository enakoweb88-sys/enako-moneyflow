# Copy these non-secret names into /opt/moneyflow/.env and set real values there.
# Never commit /opt/moneyflow/.env or real credentials.

# Supabase Session Pooler connection (SSL required)
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your-project-reference
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Immutable GHCR image references, set after CI publishes the first build.
BACKEND_IMAGE=ghcr.io/enakoweb88-sys/enako-moneyflow-backend:replace-with-commit-sha
ADMIN_IMAGE=ghcr.io/enakoweb88-sys/enako-moneyflow-admin-web:replace-with-commit-sha
CUSTOMER_IMAGE=ghcr.io/enakoweb88-sys/enako-moneyflow-customer-web:replace-with-commit-sha
