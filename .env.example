# ========================================================
# E-NAKO MONEYFLOW LOCAL ENVIRONMENT CONFIGURATION
# Copy to .env for local development: cp .env.example .env
# NEVER COMMIT REAL KEYS, SECRETS, OR CREDENTIALS
# ========================================================

# Database Credentials (Local Docker Postgres 16)
POSTGRES_DB=moneyflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/moneyflow

# Server & Ports
PORT_BACKEND=8080
PORT_ADMIN_WEB=5173
PORT_CUSTOMER_WEB=3000

# Security Tokens (Placeholders for local sandbox only)
JWT_SECRET=local_dev_jwt_secret_enako_moneyflow_2026_minimum_32_characters
MFA_SERVICE_API_KEY=sandbox_mfa_mock_key_0000000000

# Mobile-money provider credentials. Leave blank until using a provider-approved environment.
# Primary/secondary are MTN subscription keys; secondary is reserved for rotation.
PRIMARY_KEY=
SECONDARY_KEY=
DISBURSEMENT_PRIMARY_KEY=
DISBURSEMENT_SECONDARY_KEY=
DEPOSIT_API_KEY=
DEPOSIT_API_USER=
PAYMENTS_API_KEY=
PAYMENTS_API_USER=

# Orange Cameroon is routed through the PixiPay partner contract.
PIX_PAY_API_KEY=
PIX_PAY_ORANGE_CM_CASHIN_SERVICE_ID=
PIX_PAY_ORANGE_CM_CASHOUT_SERVICE_ID=

# Provider URLs and callback rules must match the approved partner portals.
MTN_MOMO_BASE_URL=https://momoapi.momo.africa
MTN_MOMO_TARGET_ENVIRONMENT=mtncameroon
MTN_MOMO_CALLBACK_URL=https://your-api.example.com/api/v1/provider-callbacks/mtn
PIX_PAY_BASE_URL=
PIX_PAY_CALLBACK_URL=https://your-api.example.com/api/v1/provider-callbacks/pixipay
BEAC_INTERBANK_ROUTING_KEY=mock_beac_routing_sandbox
